# Configuração do servidor. Copie para o gerenciador de variáveis do deploy.
# Nunca preencha chaves neste arquivo versionado.
DATABASE_URL=
VITTA_ONE_CLINIC_TIMEZONE=America/Sao_Paulo
VITTA_ONE_PUBLIC_URL=
VITTA_ONE_SESSION_TTL_SECONDS=3600
VITTA_ONE_COOKIE_SECURE=true

# Somente Asaas Sandbox. A aplicação bloqueia a URL de produção.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token próprio de webhook: 32 a 255 caracteres sem espaços; diferente da API key.
ASAAS_WEBHOOK_TOKEN=

# Resend: domínio/remetente verificado no provedor.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
