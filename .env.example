# Vitta One — exemplo sem credenciais reais
DATABASE_URL=postgresql+psycopg://vitta_one:change-me@127.0.0.1:5432/vitta_one
VITTA_ONE_SESSION_TTL_SECONDS=3600
VITTA_ONE_CLINIC_TIMEZONE=America/Sao_Paulo
VITTA_ONE_COOKIE_SECURE=false
VITTA_ONE_PUBLIC_URL=http://localhost:3000

# Anexos clínicos privados (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITTA_ONE_ATTACHMENT_MAX_BYTES=10485760
VITTA_ONE_ATTACHMENT_DOWNLOAD_TTL_SECONDS=300

# Assinatura de prescrições (ZapSign)
ZAPSIGN_API_TOKEN=
ZAPSIGN_WEBHOOK_TOKEN=
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br/api/v1

# Financeiro (Asaas Sandbox por padrão)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=Vitta-One/1.0
# Defina true somente após aprovação explícita de uso do ambiente de produção.
VITTA_ONE_ALLOW_ASAAS_PRODUCTION=false
